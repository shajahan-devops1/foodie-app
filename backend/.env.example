# Server
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AWS RDS PostgreSQL connection
PGHOST=forkwise-db.xxxxxxxxxx.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=forkwise
PGUSER=forkwise_app
PGPASSWORD=replace-with-secrets-manager-value
PGSSLMODE=require
